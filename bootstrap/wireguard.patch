+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="wg_title">WireGuard VPN</string>
+    <string name="wg_scope">Routes only this app through your VPN. Other apps, external players and Cast receivers use their own connection.</string>
